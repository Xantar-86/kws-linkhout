# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Editor / IDE
.claude/
.vscode/

# Logs en errors
/logs/
/errors/

# Secrets / notities (nooit committen)
*.txt
# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Lokale foto-backups (niet deployen, enkel lokaal bewaren)
public/images/fotos/Eendjes race 2026/

# Originele spelersfotos (265 MB); enkel de webversies in public/images/spelers/ gaan mee
public/images/kws spelers/

# Originele ploegfotos uit de camera; de bijgesneden versie staat er los naast
public/images/teams/IMG_*.JPG

# Originele foto's van de damesploegen (132 MB); enkel de webversies gaan mee,
# de groepsfoto's staan bijgesneden in public/images/teams/
public/images/spelers p1 p2 kws ladies 2026-2027/

# De kernlijst uit Excel; daar staan gsm-nummers van spelers in en alles onder
# public/ wordt publiek uitgeserveerd. De kern zelf staat in src/lib/kernen.ts.
public/Docs/Overzicht spelers*.xlsx

# Uitgeknipte spelers; afgeleid, wordt lokaal opnieuw gemaakt
public/images/uitgeknipt/
